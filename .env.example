HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://quotes:quotes_local@localhost:5432/quotes?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_OPERATION_TIMEOUT=2s

WORKER_COUNT=5
QUEUE_POLL_INTERVAL=500ms
QUEUE_MAX_PENDING=1000
JOB_LEASE_DURATION=30s
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY=1s
RECOVERY_INTERVAL=1s

PROVIDER_BASE_URL=https://api.frankfurter.dev/v2/providers/ecb
PROVIDER_HTTP_TIMEOUT=5s
PROVIDER_REQUESTS_PER_SECOND=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
